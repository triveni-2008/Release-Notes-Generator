    {
      "parameters": {
        "jsCode": "return $input.all().map(item => {\n  const commit = item.json;\n\n  return {\n    json: {\n      commit_message: commit.commit?.message || \"\",\n      author: commit.commit?.author?.name || \"\",\n      date: commit.commit?.author?.date || \"\",\n      commit_id: commit.sha || \"\"\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        128,
        -192
      ],
      "id": "463185fd-53dc-4f48-ad50-ce69bb9b68ec",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "jsCode": "const internalKeywords = [\n  \"refactor\",\n  \"rename variable\",\n  \"rename internal\",\n  \"internal\",\n  \"cleanup\",\n  \"code cleanup\",\n  \"formatting\",\n  \"lint\",\n  \"test\",\n  \"tests\",\n  \"unit test\",\n  \"dependency update\",\n  \"upgrade dependency\",\n  \"chore\"\n];\n\nconst output = [];\n\nfor (const item of $input.all()) {\n  const message = item.json.commit_message || \"\";\n  const lowerMessage = message.toLowerCase();\n\n  const isInternal = internalKeywords.some(keyword =>\n    lowerMessage.includes(keyword)\n  );\n\n  if (!isInternal) {\n    output.push({\n      json: {\n        commit_message: message,\n        author: item.json.author,\n        date: item.json.date,\n        commit_id: item.json.commit_id,\n        type: \"user-facing\"\n      }\n    });\n  }\n}\n\nreturn output;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        352,
        -192
      ],
      "id": "97e289d5-1f03-43ff-b8d3-54d01eb79137",
      "name": "Code in JavaScript1"
    },
