    {
      "parameters": {
        "jsCode": "const notes = $input.all()\n  .map(item => item.json.output?.[0]?.content?.[0]?.text || \"\")\n  .filter(Boolean);\n\nreturn [\n  {\n    json: {\n      changelog: notes.join(\"\\n\\n\")\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        848,
        -192
      ],
      "id": "1a1f2f43-c256-4fa2-9707-8478c4914f66",
      "name": "Code in JavaScript2"
    },
    {
      "parameters": {
        "jsCode": "const changelog = $json.changelog || \"\";\n\nconst cleanedNotes = changelog\n  .replace(/\\\\n\\\\n/g, \"\\n\\n\")\n  .split(\"\\n\\n\")\n  .filter(note => note.trim() !== \"\")\n  .filter(note => !note.toLowerCase().includes(\"please provide the git commit message\"));\n\nreturn [{\n  json: {\n    changelog: cleanedNotes.join(\"\\n\\n\")\n  }\n}];"
      },
