              "content": "Convert this Git commit message into one simple user-facing release note.\n\nGit commit message:\n{{$json.commit_message}}\n\nWrite only one short release note sentence.\nDo not explain the code.\nDo not mention developers, internal technical details, or commit IDs."
            },
            {}
          ]
        },
        "builtInTools": {},
